{
  "manifest_version": 3,
  "name": "SESI MINI",
  "version": "1.0.0",
  "description": "Introvert Dreams · Dola companion: downloader HD tanpa watermark, auto prompt Seedance 2.5 / 30 detik, lampiran MD, akun, lisensi online.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "SESI MINI", "default_popup": "dashboard.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "permissions": ["storage", "downloads", "cookies", "tabs", "alarms"],
  "host_permissions": ["https://*.dola.com/*", "https://dola.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://*.dola.com/*", "https://dola.com/*"], "js": ["auto-prompt.js", "inject.js", "single-clip-enforcer.js", "ext-bridge.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false },
    { "matches": ["https://*.dola.com/*", "https://dola.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": false }
  ],
  "web_accessible_resources": [{ "resources": ["dashboard.html", "dashboard.js", "dashboard.css", "icons/*", "Introvert-Dreams-SKILL-v5.md"], "matches": ["https://*.dola.com/*", "https://dola.com/*"] }]
}
